+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Oracle predictions must override estimates without changing lifecycle rules."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from tests.v1.core.cachewise.test_session_tracker import hashes, make_request
+from tests.v1.core.cachewise.utils import FakeClock
+from vllm.config import CacheConfig
+from vllm.v1.core.cachewise.manager import CacheWiseManager
+from vllm.v1.core.cachewise.session_tracker import ORACLE_DURATION_HINT_KEY
+
+
+def make_oracle():
+    manager = CacheWiseManager(
+        SimpleNamespace(cache_config=CacheConfig(cachewise_predictor="oracle"))
+    )
+    clock = FakeClock()
+    manager.time_fn = manager.tracker.time_fn = clock
+    assert manager.tracker.use_oracle
+    return manager, clock
+
+
+def tool_request(name, duration):
+    request = make_request(name, hashes(name), hint=[{"name": name}])
+    request.sampling_params.extra_args[ORACLE_DURATION_HINT_KEY] = duration
+    return request
+
+
+def test_oracle_overrides_wrong_prediction_and_counts_down():
+    manager, clock = make_oracle()
+    manager.predictor.record([("soon", "")], 1000)
+    manager.predictor.record([("late", "")], 1)
+    manager.on_request_finished(tool_request("soon", 2.0), [1])
+    manager.on_request_finished(tool_request("late", 20.0), [2])
+    tracker = manager.tracker
+    soon, late = tracker.by_tail_hash[b"soon"], tracker.by_tail_hash[b"late"]
+    assert tracker.priorities(clock()) == {soon: 2.0, late: 20.0}
+    clock.now += 5
+    assert tracker.priorities(clock()) == {soon: 0.0, late: 15.0}
+    assert tracker.stats()["num_oracle_hints"] == 2
+    assert tracker.stats()["num_oracle_predictions"] == 4
+    # A queued return retains the common immediate-reuse protection.
+    manager.on_request_queued(make_request("return", hashes("late", "extra")))
+    assert tracker.priorities(clock())[late] == 0
+    manager.on_request_removed("return")
+    assert tracker.priorities(clock())[late] == 15
+
+
+def test_terminal_turn_clears_oracle_state():
+    manager, clock = make_oracle()
+    manager.on_request_finished(tool_request("first", 10), [1])
+    returning = make_request("last", hashes("first", "last"), hint=[])
+    returning.arrival_time = clock()
+    manager.on_request_scheduled(returning)
+    manager.on_request_finished(returning, [1, 2])
+    session = next(iter(manager.tracker.sessions.values()))
+    assert session.oracle_duration_s is None
+    assert manager.tracker.priorities(clock())[session.session_id] == float("inf")
+
+
+@pytest.mark.parametrize("duration", [None, -1, float("inf"), float("nan"), True, "2"])
+def test_oracle_rejects_missing_or_invalid_duration(duration):
+    manager, _ = make_oracle()
+    with pytest.raises(ValueError, match="finite and non-negative"):
+        manager.on_request_finished(tool_request("tool", duration), [1])
+
+
+def test_estimated_policy_ignores_oracle_metadata():
+    manager = CacheWiseManager(SimpleNamespace(cache_config=CacheConfig()))
+    manager.predictor.record([("tool", "")], 1000)
+    request = tool_request("tool", 0)
+    manager.on_request_finished(request, [1])
+    session = next(iter(manager.tracker.sessions.values()))
+    assert manager.tracker.priorities(session.last_finish_ts)[session.session_id] > 900
+    assert manager.tracker.stats()["num_oracle_hints"] == 0
