+def test_idle_human_eviction_priority_is_applied_before_blocks_are_freed():
+    scheduler = create_scheduler(
+        enable_prefix_caching=True, kv_cache_eviction_policy="predictive", num_blocks=20
+    )
+    tool = make_request("tool", [1] * 48, hint=[{"name": "Bash"}])
+    human = make_request("human", [2] * 48, hint=[])
+    run_to_completion(scheduler, tool)
+    run_to_completion(scheduler, human)
+    assert scheduler.cachewise is not None
+    sid = scheduler.cachewise.tracker.by_tail_hash[human.block_hashes[-1]]
+    assert scheduler.cachewise.tracker.session_priority(sid) == float("inf")
+    assert (
+        scheduler.cachewise.tracker.classify_block(
+            next(iter(scheduler.cachewise.tracker.sessions[sid].block_ids))
+        )
+        == sid
+    )
+    run_to_completion(scheduler, make_request("big", [4] * (16 * BLOCK_SIZE)))
+    assert num_cached_tokens(scheduler, make_request("probe-tool", [1] * 48 + [3])) > (
+        num_cached_tokens(scheduler, make_request("probe-human", [2] * 48 + [3]))
+    )
+
+
+def test_queued_prefix_protected_before_other_request_allocates_then_cancelled():
+    scheduler = create_scheduler(
+        enable_prefix_caching=True,
+        kv_cache_eviction_policy="predictive",
+        num_blocks=20,
+        max_num_seqs=1,
+    )
+    manager = scheduler.cachewise
+    assert manager is not None
+    manager.predictor.record([("slow", "")], 1000)
+    manager.predictor.record([("fast", "")], 1)
+    slow = make_request("slow", [1] * 48, hint=[{"name": "slow"}])
+    run_to_completion(scheduler, slow)
+    run_to_completion(
+        scheduler, make_request("fast", [2] * 48, hint=[{"name": "fast"}])
+    )
+    sid = manager.tracker.by_tail_hash[slow.block_hashes[-1]]
+    previous_tail = manager.tracker.sessions[sid].tail_block_hash
+    big = make_request("big", [4] * (16 * BLOCK_SIZE))
+    returning = make_request("return", [1] * 48 + [1000] * 3 + [3] * 30)
+    scheduler.add_request(big)
+    scheduler.add_request(returning)
+    assert manager.tracker.session_priority(sid) == 0
+    scheduler.schedule()
+    assert num_cached_tokens(scheduler, returning) == 48
+    assert num_cached_tokens(scheduler, make_request("probe-fast", [2] * 48 + [3])) < 48
+    scheduler.finish_requests("return", RequestStatus.FINISHED_ABORTED)
+    assert not manager.tracker.queued_by_request_id
+    assert manager.tracker.sessions[sid].tail_block_hash == previous_tail
+    assert manager.tracker.session_priority(sid) > 0
+
+
+def test_abort_before_admission_does_not_create_cached_session():
+    scheduler = create_scheduler(
+        enable_prefix_caching=True, kv_cache_eviction_policy="predictive"
+    )
+    request = make_request("never-admitted", [1] * 48)
+    scheduler.add_request(request)
+    scheduler.finish_requests(request.request_id, RequestStatus.FINISHED_ABORTED)
+    assert scheduler.cachewise is not None
+    assert not scheduler.cachewise.tracker.sessions
