+def test_idle_human_evicted_before_tools_but_queued_return_is_protected():
+    tracker, predictor, clock = make_tracker()
+    predictor.record([("Bash", "")], 1000)
+    tracker.on_request_finished(make_request("human", hashes("h"), hint=[]), [1])
+    tracker.on_request_finished(
+        make_request("tool", hashes("t"), hint=[{"name": "Bash"}]), [2]
+    )
+    human_sid = tracker.by_tail_hash[b"h"]
+    tool_sid = tracker.by_tail_hash[b"t"]
+    priorities = tracker.priorities(clock.now)
+    assert priorities[human_sid] == float("inf")
+    assert priorities[human_sid] > priorities[tool_sid]
+    # An infinite-priority owner must not be mistaken for PREEMPTED_SESSION_ID.
+    assert tracker.classify_block(1) == human_sid
+    returning = make_request("return", hashes("h", "next"), clock.now)
+    assert tracker.on_request_queued(returning)
+    assert not tracker.on_request_queued(returning)
+    assert tracker.priorities(clock.now)[human_sid] == 0
+
+
+def test_queued_cancellation_preserves_cache_and_other_waiters():
+    tracker, _, clock = make_tracker()
+    tracker.on_request_finished(make_request("original", hashes("a"), hint=[]), [1])
+    sid = tracker.by_tail_hash[b"a"]
+    session = tracker.sessions[sid]
+    previous_finish = session.last_finish_ts
+    r1 = make_request("r1", hashes("a", "b"), clock.now)
+    r2 = make_request("r2", hashes("a", "c"), clock.now)
+    tracker.on_request_queued(r1)
+    tracker.on_request_queued(r2)
+    tracker.on_request_removed("r1")
+    tracker.on_request_finished(r1, [])
+    assert tracker.priorities(clock.now)[sid] == 0
+    assert session.queued_request_ids == {"r2"}
+    tracker.on_request_finished(r2, [])
+    assert tracker.priorities(clock.now)[sid] == float("inf")
+    assert session.tail_block_hash == b"a"
+    assert session.block_ids == {1}
+    assert session.last_finish_ts == previous_finish
+    assert session.last_request_id == "original"
+    assert not tracker.queued_by_request_id
+    assert tracker.num_samples_recorded == 0
+
+
+def test_queue_wait_not_learned_as_tool_duration():
+    tracker, predictor, clock = make_tracker()
+    tracker.on_request_finished(
+        make_request("original", hashes("a"), hint=[{"name": "Bash"}]), [1]
+    )
+    clock.now += 5
+    returning = make_request("return", hashes("a", "b"), clock.now)
+    tracker.on_request_queued(returning)
+    assert tracker.num_samples_recorded == 0
+    clock.now += 120
+    tracker.on_request_scheduled(returning)
+    tracker.on_request_scheduled(returning)
+    assert not tracker.queued_by_request_id
+    assert tracker.num_samples_recorded == 1
+    assert predictor.predict_remaining([("Bash", "")], 0) == pytest.approx(5, rel=0.3)
+
+
+def test_queued_sessions_survive_ttl_and_cap_then_clear(monkeypatch):
+    monkeypatch.setattr("vllm.v1.core.cachewise.session_tracker._MAX_SESSIONS", 1)
+    tracker, _, clock = make_tracker(ttl=10)
+    tracker.on_request_finished(make_request("original", hashes("a")), [1])
+    sid = tracker.by_tail_hash[b"a"]
+    tracker.on_request_queued(make_request("return", hashes("a", "b"), clock.now))
+    clock.now += 100
+    tracker.prune(clock.now)
+    tracker.on_request_finished(make_request("other", hashes("x")), [2])
+    assert sid in tracker.sessions
+    assert tracker.queued_by_request_id == {"return": sid}
+    tracker.clear()
+    assert not tracker.queued_by_request_id
+
+
+def test_concurrent_return_does_not_lose_session_when_tail_advances():
+    tracker, _, clock = make_tracker()
+    tracker.on_request_finished(make_request("original", hashes("a")), [1])
+    sid = tracker.by_tail_hash[b"a"]
+    r1 = make_request("r1", hashes("a", "b"), clock.now)
+    r2 = make_request("r2", hashes("a", "c"), clock.now)
+    tracker.on_request_queued(r1)
+    tracker.on_request_queued(r2)
+    tracker.on_request_scheduled(r1)
+    tracker.on_request_finished(r1, [1, 2])
+    tracker.on_request_scheduled(r2)
+    assert tracker.by_request_id["r2"] == sid
+    assert tracker.num_sessions_created == 1
+
+
+def test_one_active_finish_does_not_unprotect_another_active_return():
+    tracker, _, clock = make_tracker()
+    tracker.on_request_finished(make_request("original", hashes("a")), [1])
+    sid = tracker.by_tail_hash[b"a"]
+    r1 = make_request("r1", hashes("a", "b"), clock.now)
+    r2 = make_request("r2", hashes("a", "c"), clock.now)
+    tracker.on_request_scheduled(r1)
+    tracker.on_request_scheduled(r2)
+    tracker.on_request_finished(r1, [1, 2])
+    assert tracker.priorities(clock.now)[sid] == 0
+    tracker.on_request_finished(r2, [])
+    assert not tracker.sessions[sid].in_flight
