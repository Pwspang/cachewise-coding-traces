+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Tests for InferCept min-waste retention of paused sessions."""
+
+import json
+
+import pytest
+
+from tests.v1.core.cachewise.test_scheduler_cachewise import (
+    BLOCK_SIZE,
+    make_request,
+    num_cached_tokens,
+    run_to_completion,
+)
+from tests.v1.core.cachewise.test_session_tracker import hashes
+from tests.v1.core.cachewise.test_session_tracker import (
+    make_request as make_tracker_request,
+)
+from tests.v1.core.cachewise.utils import FakeClock
+from tests.v1.core.utils import create_scheduler
+from vllm.v1.core.cachewise.infercept import (
+    InferCeptManager,
+    InferCeptTracker,
+    load_recompute_profile,
+)
+from vllm.v1.core.cachewise.predictor import ToolReusePredictor
+
+DEFAULT_REUSE_S = 120.0
+
+
+def make_tracker(coeffs=(0.0, 0.0, 1.0), running_tokens=0):
+    clock = FakeClock()
+    running = {"tokens": running_tokens}
+    tracker = InferCeptTracker(
+        predictor=ToolReusePredictor(default_reuse_s=DEFAULT_REUSE_S),
+        default_reuse_s=DEFAULT_REUSE_S,
+        session_ttl_s=1800.0,
+        time_fn=clock,
+        block_size=16,
+        recompute_s_coeffs=coeffs,
+        running_tokens_fn=lambda: running["tokens"],
+    )
+    return tracker, clock, running
+
+
+def finish(tracker, request_id, tag, block_ids, hint):
+    request = make_tracker_request(request_id, hashes(tag), hint=hint)
+    tracker.on_request_finished(request, block_ids)
+    return tracker.by_tail_hash[tag.encode()]
+
+
+def test_paused_context_preserved_until_waste_exceeds_recompute():
+    # 4 blocks = 64 tokens; T_rec = 1 s, so WasteDiscard = 1 * (32 + 0).
+    # WastePreserve = elapsed * 64 crosses it at elapsed = 0.5 s.
+    tracker, clock, _ = make_tracker()
+    sid = finish(tracker, "r", "a", [1, 2, 3, 4], [{"name": "Bash"}])
+    clock.now += 0.25
+    priority = tracker.priorities(clock.now)[sid]
+    assert priority == pytest.approx(0.25 * 64 / 32 * DEFAULT_REUSE_S)
+    assert priority < DEFAULT_REUSE_S
+    assert tracker.stats()["num_preserved_sessions"] == 1
+    clock.now += 0.5
+    assert tracker.priorities(clock.now)[sid] == pytest.approx(DEFAULT_REUSE_S + 0.75)
+    assert tracker.stats()["num_discarded_sessions"] == 1
+
+
+def test_running_context_raises_discard_waste():
+    # Recompute stalls the running batch, so a larger C_other keeps the
+    # paused context preserved for longer (threshold (32 + 960) / 64 s).
+    tracker, clock, running = make_tracker()
+    sid = finish(tracker, "r", "a", [1, 2, 3, 4], [{"name": "Bash"}])
+    clock.now += 10.0
+    assert tracker.priorities(clock.now)[sid] > DEFAULT_REUSE_S
+    running["tokens"] = 960
+    assert tracker.priorities(clock.now)[sid] < DEFAULT_REUSE_S
+    clock.now += 6.0
+    assert tracker.priorities(clock.now)[sid] > DEFAULT_REUSE_S
+
+
+def test_quadratic_recompute_profile_is_applied():
+    tracker, _, _ = make_tracker(coeffs=(1e-6, 1e-3, 0.5))
+    assert tracker.recompute_s(1000) == pytest.approx(1.0 + 1.0 + 0.5)
+    assert tracker.waste(1000, 2.0, 500) == pytest.approx((2000.0, 2.5 * 1000))
+
+
+def test_finished_turns_discarded_lru_and_active_sessions_protected():
+    tracker, clock, _ = make_tracker()
+    human_old = finish(tracker, "h1", "h1", [1], [])
+    clock.now += 5.0
+    human_new = finish(tracker, "h2", "h2", [2], [])
+    tool = finish(tracker, "t", "t", [3, 4], [{"name": "Read"}])
+    unknown = finish(tracker, "u", "u", [5], None)
+    clock.now += 0.01
+    returning = make_tracker_request("ret", hashes("t", "next"), clock.now)
+    priorities = tracker.priorities(clock.now)
+    assert priorities[human_old] > priorities[human_new] > DEFAULT_REUSE_S
+    assert priorities[tool] < DEFAULT_REUSE_S
+    assert priorities[unknown] == DEFAULT_REUSE_S
+    assert tracker.on_request_queued(returning)
+    assert tracker.priorities(clock.now)[tool] == 0.0
+
+
+def test_recompute_profile_validation(tmp_path):
+    path = tmp_path / "profile.json"
+    path.write_text(json.dumps({"recompute_s_coeffs": [1e-9, 2e-4, 0.05]}))
+    assert load_recompute_profile(str(path)) == (1e-9, 2e-4, 0.05)
+    path.write_text(json.dumps({"recompute_s_coeffs": [0, -1, 0]}))
+    with pytest.raises(ValueError, match="Non-physical"):
+        load_recompute_profile(str(path))
+
+
+def test_infercept_requires_profile():
+    with pytest.raises(ValueError, match="infercept_recompute_profile"):
+        create_scheduler(
+            enable_prefix_caching=True, kv_cache_eviction_policy="infercept"
+        )
+
+
+def test_infercept_scheduler_evicts_discarded_before_preserved(tmp_path):
+    profile = tmp_path / "profile.json"
+    profile.write_text(json.dumps({"recompute_s_coeffs": [0.0, 0.0, 1.0]}))
+    scheduler = create_scheduler(
+        enable_prefix_caching=True,
+        kv_cache_eviction_policy="infercept",
+        infercept_recompute_profile=str(profile),
+        num_blocks=20,
+        block_size=BLOCK_SIZE,
+    )
+    manager = scheduler.cachewise
+    assert isinstance(manager, InferCeptManager)
+    clock = FakeClock()
+    manager.time_fn = clock
+    manager.tracker.time_fn = clock
+    # Session A pauses first; by the time B pauses, A has waited longer
+    # than its recompute break-even (0.5 s) and is discarded.
+    run_to_completion(scheduler, make_request("a", [1] * 48, hint=[{"name": "x"}]))
+    clock.now += 10.0
+    run_to_completion(scheduler, make_request("b", [2] * 48, hint=[{"name": "x"}]))
+    stats = manager.stats()
+    assert stats["num_preserved_sessions"] == 1
+    assert stats["num_discarded_sessions"] == 1
+    run_to_completion(scheduler, make_request("big", [4] * (16 * BLOCK_SIZE)))
+    hits_a = num_cached_tokens(scheduler, make_request("probe-a", [1] * 48 + [3]))
+    hits_b = num_cached_tokens(scheduler, make_request("probe-b", [2] * 48 + [3]))
+    assert hits_a < hits_b
