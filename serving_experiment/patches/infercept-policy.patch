diff --git a/vllm/v1/core/cachewise/infercept.py b/vllm/v1/core/cachewise/infercept.py
new file mode 100644
index 0000000..46d2cb2
--- /dev/null
+++ b/vllm/v1/core/cachewise/infercept.py
@@ -0,0 +1,153 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""InferCept-style min-waste retention of paused agent contexts.
+
+Adapts the Preserve/Discard decision of InferCept (Abhyankar et al., ICML
+2024, arXiv 2402.01869) to prefix-cached KV blocks. A session whose last
+request ended in a tool call is an intercepted request. Its context is kept
+("preserved", evicted last) while preserving wastes less memory-time than
+recomputing it, and is otherwise "discarded" into LRU order.
+
+With M (bytes per token) cancelled from both sides, for a cached context of
+C tokens paused since t_call:
+
+    WastePreserve = T_INT * C                         (paper Eq. 2)
+    WasteDiscard  = T_rec(C) * (C / 2 + C_other)      (paper Eq. 4, chunked)
+
+T_INT uses the paper's dynamic estimate t_now - t_call (section 4.4); no
+tool-duration predictor is consulted. T_rec(C) is the profiled time to
+prefill C uncached tokens with chunked prefill, so it already sums the
+per-chunk iteration costs n * T_fwd(C / n) of Eq. 4. C_other is the context
+of the other running requests, which stall while the recompute runs.
+Decisions are re-evaluated at every priority rebuild (section 4.5).
+
+Swap (Eq. 3) is not modelled: it needs a CPU KV tier the LRU and CacheWise
+policies do not get, which would make the memory budgets unequal.
+"""
+
+import json
+from collections.abc import Callable
+from typing import TYPE_CHECKING
+
+from vllm.v1.core.cachewise.manager import CacheWiseManager
+from vllm.v1.core.cachewise.session_tracker import (
+    PREEMPTED_SESSION_ID,
+    SessionTracker,
+)
+
+if TYPE_CHECKING:
+    from vllm.config import VllmConfig
+
+
+def load_recompute_profile(path: str) -> tuple[float, float, float]:
+    """Read quadratic T_rec(C) = a*C^2 + b*C + c coefficients (seconds)."""
+    with open(path) as f:
+        a, b, c = (float(x) for x in json.load(f)["recompute_s_coeffs"])
+    if a < 0 or b < 0:
+        raise ValueError(f"Non-physical recompute profile in {path}: {a}, {b}, {c}")
+    return a, b, c
+
+
+class InferCeptTracker(SessionTracker):
+    """Session tracker whose priorities follow InferCept's min-waste rule.
+
+    Priorities keep the predictive queue's convention (larger is evicted
+    first), but encode a decision rather than a reuse time:
+
+    - in-flight/queued sessions: 0.
+    - preserved: ratio * default_reuse_s, with ratio = preserve / discard
+      waste in [0, 1); the context closest to flipping is evicted first if
+      preserved contexts alone cannot satisfy an allocation.
+    - discarded (and finished turns with no tool call, which InferCept frees
+      on completion): default_reuse_s + elapsed, i.e. LRU among themselves
+      and ahead of untracked blocks.
+    """
+
+    def __init__(
+        self,
+        *args,
+        block_size: int,
+        recompute_s_coeffs: tuple[float, float, float],
+        running_tokens_fn: Callable[[], int],
+        **kwargs,
+    ) -> None:
+        super().__init__(*args, **kwargs)
+        self.block_size = block_size
+        self.recompute_s_coeffs = recompute_s_coeffs
+        self.running_tokens_fn = running_tokens_fn
+        self.num_preserved = 0
+        self.num_discarded = 0
+
+    def recompute_s(self, tokens: int) -> float:
+        a, b, c = self.recompute_s_coeffs
+        return a * tokens * tokens + b * tokens + c
+
+    def waste(self, tokens: int, elapsed_s: float, other_tokens: int):
+        """(WastePreserve, WasteDiscard) in token-seconds."""
+        preserve = elapsed_s * tokens
+        discard = self.recompute_s(tokens) * (tokens / 2 + other_tokens)
+        return preserve, discard
+
+    def priorities(self, now: float) -> dict[int, float]:
+        other_tokens = self.running_tokens_fn()
+        priorities: dict[int, float] = {}
+        preserved = discarded = 0
+        for session_id, session in self.sessions.items():
+            elapsed_s = max(0.0, now - session.last_finish_ts)
+            if session.in_flight or session.queued_request_ids:
+                priority = 0.0
+            elif session.pending_tools is None:
+                # Awaiting a tool report: whether it is paused is unknown yet.
+                priority = self.default_reuse_s
+            elif not session.pending_tools:
+                priority = self.default_reuse_s + elapsed_s
+                discarded += 1
+            else:
+                tokens = len(session.block_ids) * self.block_size
+                preserve, discard = self.waste(tokens, elapsed_s, other_tokens)
+                if tokens and preserve < discard:
+                    priority = preserve / discard * self.default_reuse_s
+                    preserved += 1
+                else:
+                    priority = self.default_reuse_s + elapsed_s
+                    discarded += 1
+            priorities[session_id] = priority
+        if self._preempted_block_to_req:
+            priorities[PREEMPTED_SESSION_ID] = 0.0
+        self.num_preserved, self.num_discarded = preserved, discarded
+        self._last_priorities = priorities
+        return priorities
+
+    def stats(self) -> dict[str, int]:
+        return {
+            **super().stats(),
+            "num_preserved_sessions": self.num_preserved,
+            "num_discarded_sessions": self.num_discarded,
+        }
+
+
+class InferCeptManager(CacheWiseManager):
+    """CacheWise lifecycle plumbing with InferCept retention decisions."""
+
+    def __init__(
+        self,
+        vllm_config: "VllmConfig",
+        block_size: int,
+        running_tokens_fn: Callable[[], int],
+    ) -> None:
+        super().__init__(vllm_config)
+        cache_config = vllm_config.cache_config
+        profile = cache_config.infercept_recompute_profile
+        if profile is None:
+            raise ValueError(
+                "kv_cache_eviction_policy='infercept' requires "
+                "infercept_recompute_profile."
+            )
+        self.tracker = InferCeptTracker(
+            predictor=self.predictor,
+            default_reuse_s=self.default_reuse_s,
+            session_ttl_s=cache_config.cachewise_session_ttl,
+            block_size=block_size,
+            recompute_s_coeffs=load_recompute_profile(profile),
+            running_tokens_fn=running_tokens_fn,
+        )
